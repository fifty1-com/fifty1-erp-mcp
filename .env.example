# Basis-URL der ERP-API (ohne abschließenden Slash)
# Produktion: https://erp.fifty1.com/api
# Lokal (docker-compose des ERP): http://localhost:8080/api
FIFTY1_API_BASE_URL=https://erp.fifty1.com/api

# --- Lokaler Betrieb über stdio (dist/index.js) ---------------------------
# Persönlicher Token aus dem ERP (Profil → API-Tokens) oder Service-Token
# (Einstellungen → API Tokens). Beim Service-Token nur die tatsächlich
# benötigten api.*-Berechtigungen vergeben — ohne Auswahl hat er Vollzugriff.
FIFTY1_API_TOKEN=

# --- Remote-Betrieb über HTTP + OAuth (dist/http.js) ----------------------
# Öffentliche URL des MCP-Endpoints. Muss exakt der Audience entsprechen,
# die das ERP in die OAuth-Tokens schreibt. http nur für localhost.
MCP_PUBLIC_URL=https://erp.fifty1.com/mcp
# Lokale Adresse, auf der der Server hinter Apache lauscht.
PORT=3030
HOST=127.0.0.1
